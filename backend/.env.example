# PostgreSQL connection (SQLAlchemy URL, psycopg 3 driver)
DATABASE_URL=postgresql+psycopg://jewellery:jewellery@localhost:5433/jewellery

# JWT signing secret. Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=480
REMEMBER_ME_EXPIRE_DAYS=14

# Comma-separated list of frontend origins allowed to call the API
CORS_ORIGINS=http://localhost:5173

# Public URL of the frontend. QR codes encode {PUBLIC_BASE_URL}/verify/{token}.
# To scan from a phone during development, use your computer's LAN IP, e.g. http://192.168.1.20:5173
PUBLIC_BASE_URL=http://localhost:5173

# Certificate and product photo uploads
MAX_UPLOAD_MB=4

# Live gold rate. Set one key; leave both empty to show buyers the registered prices.
# metals.dev (https://metals.dev, free plan, no card) gives the IBJA rate, which tracks Indian shop rates.
METALS_DEV_API_KEY=
# GoldAPI.io (https://www.goldapi.io) gives the international spot rate. Ignored when METALS_DEV_API_KEY is set.
GOLDAPI_KEY=
# Minutes a fetched rate is reused. 480 = at most about 90 requests a month, inside the 100 of a free plan.
GOLD_RATE_TTL_MINUTES=480

# Demo admin created by `python seed.py`
SEED_ADMIN_NAME=Store Administrator
SEED_ADMIN_EMAIL=admin@jewelverify.demo
SEED_ADMIN_PASSWORD=Admin@12345
